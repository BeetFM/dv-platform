{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dv-platform.local/schemas/documentation/local-task-audit-v1.schema.json",
  "title": "DV Platform local task audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_date", "scope", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "audit_date": {"type": "string", "format": "date"},
    "scope": {"const": "all current roadmap tasks and all tracked Markdown"},
    "tasks": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticket", "local_work_state", "closure_blocker", "evidence"],
        "properties": {
          "ticket": {"type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)*-[0-9]+$"},
          "local_work_state": {
            "enum": ["completed", "regression_closed", "no_authorized_local_work", "pending_local"]
          },
          "closure_blocker": {
            "enum": [
              "none",
              "external_tool_evidence",
              "hosted_or_protected_evidence",
              "licensed_signed_evidence",
              "owner_decision"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
