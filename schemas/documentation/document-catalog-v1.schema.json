{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dv-platform.local/schemas/documentation/document-catalog-v1.schema.json",
  "title": "DV Platform document catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "source_inventory", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"const": "qualification/policies/document-catalog-v1.json"},
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sha256", "definition"],
      "properties": {
        "count": {"const": 70},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "definition": {"const": "scripts/checks/repository_contracts.py:CONSOLIDATED_GUIDES"}
      }
    },
    "documents": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path", "class", "authority", "effective_date", "supersedes",
          "successor", "known_issues", "capability_ids", "stable_anchor"
        ],
        "properties": {
          "path": {"type": "string", "pattern": "^(docs/)?[^/]+\\.md$"},
          "class": {"enum": ["current_authority", "historical_log", "legal_notice"]},
          "authority": {"type": "string", "minLength": 1},
          "effective_date": {"type": "string", "format": "date"},
          "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "successor": {"type": ["string", "null"]},
          "known_issues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "capability_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "stable_anchor": {"type": "string", "pattern": "^#[a-z0-9-]+$"}
        }
      }
    }
  }
}
