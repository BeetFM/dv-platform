{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dv-platform.local/schemas/documentation/progress-ledger-v1.schema.json",
  "title": "DV Platform machine progress ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transitions"],
  "properties": {
    "schema_version": {"const": 1},
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticket", "sequence", "from", "to", "date", "evidence"],
        "properties": {
          "ticket": {"type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)*-[0-9]+$"},
          "sequence": {"type": "integer", "minimum": 1},
          "from": {"enum": ["open", "in_progress", "closed", "regressed"]},
          "to": {"enum": ["in_progress", "closed", "regressed", "open"]},
          "date": {"type": "string", "format": "date"},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    }
  }
}
