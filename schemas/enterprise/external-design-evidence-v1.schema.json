{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veriforge.dev/schemas/external-design-evidence-v1.schema.json",
  "title": "Veriforge external design semantic qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design_id", "repository", "commit", "input_sha256", "top", "status", "frontends", "comparison", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "design_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "repository": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "license_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "top": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["passed", "failed"]},
    "frontends": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "status", "artifact_sha256"],
        "properties": {
          "name": {"enum": ["verilator", "slang", "surelog"]},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "issues", "required_capabilities", "surelog_top_confirmed"],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "issues": {"type": "integer", "minimum": 0},
        "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "surelog_top_confirmed": {"type": "boolean"}
      }
    },
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
