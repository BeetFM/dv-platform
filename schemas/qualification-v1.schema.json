{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dv-platform.local/schemas/qualification-v1.schema.json",
  "title": "dv-platform qualification record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "level",
    "mode",
    "qualified_at",
    "families",
    "languages",
    "tools",
    "fixture_hashes",
    "checks",
    "attestation_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "level": {
      "enum": ["unverified", "contract_verified", "surrogate_verified", "vendor_verified"]
    },
    "mode": {"enum": ["fixture", "surrogate", "vendor"]},
    "qualified_at": {"type": "string", "format": "date-time"},
    "families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "languages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "fixture_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "family", "status", "tool", "message", "evidence_sha256"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "family": {"enum": ["simulator", "formal", "analyzer"]},
          "status": {"const": "passed"},
          "tool": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "attestation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
