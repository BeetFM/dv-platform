{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dv-platform.local/schemas/enterprise-result-v1.schema.json",
  "title": "dv-platform enterprise result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "checks", "artifacts", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["passed", "failed", "error"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "module", "kind", "status"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "module": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "skipped", "unknown"]},
          "message": {"type": "string", "minLength": 1},
          "source_location": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}
