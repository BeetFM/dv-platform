{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dv-platform.local/schemas/requirements-v1.schema.json",
  "title": "dv-platform governed requirements baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "baseline_id", "exported_at", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "producer": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "exported_at": {"type": "string", "format": "date-time"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id", "scope", "statement", "status", "verification_method"
        ],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "expected_value": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "verification_method": {"type": "string", "minLength": 1},
          "parent_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "tags": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
