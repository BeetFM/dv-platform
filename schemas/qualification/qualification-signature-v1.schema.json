{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veriforge.dev/schemas/qualification-signature-v1.schema.json",
  "title": "Veriforge detached vendor qualification signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "signature_kind",
    "attestation_sha256",
    "signature_file",
    "certificate_file",
    "signed_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "purpose": {"const": "veriforge-vendor-qualification"},
    "signature_kind": {"const": "enterprise_pki"},
    "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_file": {"type": "string", "minLength": 1},
    "certificate_file": {"type": "string", "minLength": 1},
    "signed_at": {"type": "string", "format": "date-time"}
  }
}
