{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dv-platform.invalid/schemas/qualification/arty-a7-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "board_revision", "bom_variant", "device", "usb_jtag_serial", "fixture_id", "vivado_version", "constraints_revision", "constraints_sha256", "source_revision", "bitstream_sha256", "completed_at", "build_checks", "lab_checks", "mutants", "flash_restored", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"enum": ["arty-a7-35t-rev-c", "arty-a7-35t-rev-e", "arty-a7-100t-rev-e"]},
    "board_revision": {"enum": ["C", "E", "E.2"]},
    "bom_variant": {"type": "string", "minLength": 1},
    "device": {"enum": ["XC7A35TICSG324-1L", "XC7A100TCSG324-1"]},
    "usb_jtag_serial": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "vivado_version": {"const": "2025.2"},
    "constraints_revision": {"type": "string", "minLength": 1},
    "constraints_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "minLength": 1},
    "bitstream_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "completed_at": {"type": "string", "format": "date-time"},
    "build_checks": {"type": "object"},
    "lab_checks": {"type": "object"},
    "mutants": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "flash_restored": {"const": true},
    "signature": {"type": "object"}
  }
}
