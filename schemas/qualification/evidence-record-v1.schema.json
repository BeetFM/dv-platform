{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veriforge.dev/schemas/evidence-record-v1.schema.json",
  "title": "Veriforge reusable qualification evidence record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_sha256", "configuration_sha256", "profile_sha256",
    "profile_id", "profile_version", "role", "target", "tool_versions",
    "commands", "expected_checks", "mutant_outcomes", "coverage",
    "non_vacuity", "strict_status", "execution_kind"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "target": {"enum": ["cocotb", "formal", "systemverilog", "verilog", "vhdl", "uvm"]},
    "tool_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mutant_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mutant_id", "killed", "check_ids"],
        "properties": {
          "mutant_id": {"type": "string", "minLength": 1},
          "killed": {"type": "boolean"},
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "measured_ids", "missing_ids"],
      "properties": {
        "schema_version": {"const": 3},
        "measured_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "missing_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "non_vacuity": {"enum": ["passed", "failed", "not_applicable"]},
    "strict_status": {"enum": ["passed", "failed"]},
    "execution_kind": {"enum": ["real", "mocked"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
