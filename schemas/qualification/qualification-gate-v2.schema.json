{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veriforge.dev/schemas/qualification-gate-v2.schema.json",
  "title": "Veriforge contextual qualification gate policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stages", "evidence_types", "impact_policy"],
  "properties": {
    "schema_version": {"const": 2},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "required_evidence", "freshness"], "properties": {"stage": {"type": "integer", "minimum": 6, "maximum": 13}, "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "freshness": {"enum": ["historical", "candidate", "reusable"]}, "impact_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "evidence_types": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "schema", "validator"], "properties": {"id": {"type": "string", "minLength": 1}, "schema": {"type": "string", "minLength": 1}, "validator": {"type": "string", "minLength": 1}}}},
    "impact_policy": {"type": "object", "additionalProperties": false, "required": ["hash_algorithm", "unknown_path_behavior"], "properties": {"hash_algorithm": {"const": "sha256"}, "unknown_path_behavior": {"const": "fail_closed"}, "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  }
}
