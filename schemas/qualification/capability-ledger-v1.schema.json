{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veriforge.dev/schemas/capability-ledger-v1.schema.json",
  "title": "Veriforge current capability ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "cells"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"const": "current"},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id", "profile_version", "role", "target", "bound", "state",
          "required_tool", "evidence_digest", "last_passing_source", "source"
        ],
        "properties": {
          "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
          "profile_version": {"type": "string", "minLength": 1},
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "target": {
            "enum": ["cocotb", "formal", "systemverilog", "verilog", "vhdl", "uvm"]
          },
          "bound": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maximum_burst_length", "maximum_outstanding", "timeout_cycles"],
            "properties": {
              "maximum_burst_length": {"type": "integer", "minimum": 1},
              "maximum_outstanding": {"type": "integer", "minimum": 1},
              "timeout_cycles": {"type": "integer", "minimum": 1}
            }
          },
          "state": {
            "enum": ["supported", "partial", "contract_verified", "scaffold", "unsupported", "regressed"]
          },
          "required_tool": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1}
                }
              }
            ]
          },
          "evidence_digest": {
            "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]
          },
          "evidence_path": {
            "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
          },
          "last_passing_source": {
            "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}]
          },
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
