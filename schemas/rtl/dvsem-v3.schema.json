{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dv-platform.local/schemas/dvsem-v3.schema.json",
  "title": "dv-platform semantic manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "modules", "diagnostics"],
  "properties": {
    "schema_version": {"const": 3},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "completenessState": {
      "enum": ["complete", "partial", "unsupported", "not_applicable"]
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lexical_preprocessing", "libraries_compilation_units", "design_units", "declarations",
        "types", "expressions", "statements", "subprograms", "hierarchy", "elaboration",
        "parameters_generics", "ports", "packages_imports", "interfaces_modports",
        "classes_randomization", "assignments", "processes", "assertions", "functional_coverage",
        "generates", "memories", "timing_specify", "foreign_interfaces", "attributes_pragmas",
        "file_io", "clocks_resets", "cdc", "protocols"
      ],
      "properties": {
        "lexical_preprocessing": {"$ref": "#/$defs/completenessState"},
        "libraries_compilation_units": {"$ref": "#/$defs/completenessState"},
        "design_units": {"$ref": "#/$defs/completenessState"},
        "declarations": {"$ref": "#/$defs/completenessState"},
        "types": {"$ref": "#/$defs/completenessState"},
        "expressions": {"$ref": "#/$defs/completenessState"},
        "statements": {"$ref": "#/$defs/completenessState"},
        "subprograms": {"$ref": "#/$defs/completenessState"},
        "hierarchy": {"$ref": "#/$defs/completenessState"},
        "elaboration": {"$ref": "#/$defs/completenessState"},
        "parameters_generics": {"$ref": "#/$defs/completenessState"},
        "ports": {"$ref": "#/$defs/completenessState"},
        "packages_imports": {"$ref": "#/$defs/completenessState"},
        "interfaces_modports": {"$ref": "#/$defs/completenessState"},
        "classes_randomization": {"$ref": "#/$defs/completenessState"},
        "assignments": {"$ref": "#/$defs/completenessState"},
        "processes": {"$ref": "#/$defs/completenessState"},
        "assertions": {"$ref": "#/$defs/completenessState"},
        "functional_coverage": {"$ref": "#/$defs/completenessState"},
        "generates": {"$ref": "#/$defs/completenessState"},
        "memories": {"$ref": "#/$defs/completenessState"},
        "timing_specify": {"$ref": "#/$defs/completenessState"},
        "foreign_interfaces": {"$ref": "#/$defs/completenessState"},
        "attributes_pragmas": {"$ref": "#/$defs/completenessState"},
        "file_io": {"$ref": "#/$defs/completenessState"},
        "clocks_resets": {"$ref": "#/$defs/completenessState"},
        "cdc": {"$ref": "#/$defs/completenessState"},
        "protocols": {"$ref": "#/$defs/completenessState"}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "width", "signed", "determination", "context_type", "cast_kind",
        "truncation", "unknown_bits", "source_location", "frontend_identity",
        "specialization_identity", "children"
      ],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]},
        "dtype_id": {"type": ["string", "null"]},
        "width": {"type": ["integer", "null"], "minimum": 0},
        "signed": {"type": ["boolean", "null"]},
        "determination": {"enum": ["self", "context", "unknown"]},
        "context_type": {"type": ["string", "null"]},
        "cast_kind": {"type": ["string", "null"]},
        "truncation": {"enum": ["yes", "no", "unknown"]},
        "unknown_bits": {"enum": ["present", "absent", "unknown"]},
        "packed_range": {"type": ["string", "null"]},
        "source_location": {"type": ["string", "null"]},
        "frontend_identity": {"type": ["string", "null"]},
        "specialization_identity": {"type": ["string", "null"]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/expression"}}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "language", "standard", "source", "completeness"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "original_name": {"type": "string", "minLength": 1},
        "elaborated_name": {"type": "string", "minLength": 1},
        "specialization_id": {"type": "string", "minLength": 1},
        "design_unit_kind": {"type": "string", "minLength": 1},
        "language": {"enum": ["systemverilog", "verilog", "vhdl"]},
        "standard": {"type": "string", "minLength": 1},
        "library": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "completeness": {"$ref": "#/$defs/completeness"},
        "ports": {"type": "array", "items": {"type": "object"}},
        "parameters": {"type": "array", "items": {"type": "object"}},
        "types": {"type": "array", "items": {"type": "object"}},
        "memories": {"type": "array", "items": {"type": "object"}},
        "memory_accesses": {"type": "array", "items": {"type": "object"}},
        "clocks": {"type": "array", "items": {"type": "object"}},
        "resets": {"type": "array", "items": {"type": "object"}},
        "semantic_features": {"type": "array", "items": {"type": "object"}},
        "instances": {"type": "array", "items": {"type": "object"}},
        "continuous_assignments": {"type": "array", "items": {"type": "object"}},
        "procedural_blocks": {"type": "array", "items": {"type": "object"}},
        "assertions": {"type": "array", "items": {"type": "string"}},
        "covers": {"type": "array", "items": {"type": "string"}},
        "generate_scopes": {"type": "array", "items": {"type": "object"}},
        "imports": {"type": "array", "items": {"type": "string"}},
        "control_domains": {"type": "array", "items": {"type": "object"}},
        "cdc_paths": {"type": "array", "items": {"type": "object"}},
        "protocols": {"type": "array", "items": {"type": "object"}},
        "documentation_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error"]},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "source_location": {"type": "string", "minLength": 1}
      }
    }
  }
}
